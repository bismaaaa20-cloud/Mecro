-- FireServer() → server equip item tier tertinggi di backpack
-- ================================================================
if EquipEvent then
    task.spawn(function()
        while true do
            local ok, err = pcall(function() EquipEvent:FireServer() end)
            if not ok then warn("[EquipBest] " .. tostring(err)) end
            task.wait(CFG.LOOP_DELAY)
        end
    end)
else
    warn("[EquipBest] Remote 'BackpackEquipBest' ga ketemu — diskip")
end

