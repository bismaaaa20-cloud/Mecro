-- ================================================================
-- MODULE F · ClaimPlaytimeReward Sequential Loop (tier 1 → 15)
-- Sequential bukan parallel — server validasi tier secara ordered
-- Fire(1) → wait → Fire(2) → ... → Fire(15) → jeda → ulang dari 1
-- ================================================================
if PlaytimeRemote then
    task.spawn(function()
        while true do
            for tier = 1, 15 do
                local ok, err = pcall(function()
                    return PlaytimeRemote:InvokeServer(tier)
                end)
                if not ok then
                    warn("[Playtime] Tier " .. tier .. " reject: " .. tostring(err))
                end
                task.wait(CFG.PLAYTIME_DELAY)
            end
            warn("[Playtime] Cycle 1→15 done — restart in " .. CFG.PLAYTIME_CYCLE_WAIT .. "s")
            task.wait(CFG.PLAYTIME_CYCLE_WAIT)
        end
    end)
else
    warn("[Playtime] Remote 'ClaimPlaytimeReward' ga ketemu — diskip")
end

